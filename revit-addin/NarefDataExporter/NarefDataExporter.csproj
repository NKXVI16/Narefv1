<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2025/2026 run on .NET 8. For Revit 2024 and earlier the API
         requires .NET Framework 4.8 — change RevitVersion AND TargetFramework. -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>NarefDataExporter</AssemblyName>
    <RootNamespace>NarefDataExporter</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The UI is built in code (no XAML), so a plain WPF framework reference
         suffices and the project cross-compiles on non-Windows machines too. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <!-- Reference-only Revit API assemblies (not bundled into output);
         Revit provides the real ones at runtime. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
  </ItemGroup>

</Project>
